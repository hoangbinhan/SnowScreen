{
  "manifest_version": 3,
  "name": "SnowScreen — Snow on the Web",
  "version": "1.0.2",
  "description": "Snowfall on every web page with layered depth, wind and eight snowflake shapes.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "128": "icons/icon-128.png" },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "SnowScreen",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["settings.js", "snow.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
